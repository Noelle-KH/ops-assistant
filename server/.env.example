# Server Configuration
PORT=3001
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (SQLite for local, Turso for production)
# For local SQLite:
DB_URL=file:sqlite.db
# DB_AUTH_TOKEN= (Not needed for local SQLite)

# For Turso (Production):
# DB_URL=libsql://your-database-name.turso.io
# DB_AUTH_TOKEN=your_turso_auth_token
